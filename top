[32m+[m[32m    # Common single attributes that may hold tuple/list/set/dict.[m
[32m+[m[32m    container_attrs = [[m
[32m+[m[32m        "parent_ids",[m
[32m+[m[32m        "parents",[m
[32m+[m[32m        "parent_pair",[m
[32m+[m[32m        "parent_id_pair",[m
[32m+[m[32m    ][m
[32m+[m
[32m+[m[32m    for attr in container_attrs:[m
[32m+[m[32m        if not hasattr(rock, attr):[m
[32m+[m[32m            continue[m
[32m+[m
[32m+[m[32m        value = getattr(rock, attr)[m
[32m+[m
[32m+[m[32m        if callable(value):[m
[32m+[m[32m            value = value()[m
[32m+[m
[32m+[m[32m        if value is None:[m
[32m+[m[32m            continue[m
[32m+[m
[32m+[m[32m        if isinstance(value, dict):[m
[32m+[m[32m            raw_values = list(value.values())[m
[32m+[m[32m        elif isinstance(value, (list, tuple, set)):[m
[32m+[m[32m            raw_values = list(value)[m
[32m+[m[32m        else:[m
[32m+[m[32m            raw_values = [value][m
[32m+[m
[32m+[m[32m        cleaned = [][m
[32m+[m
[32m+[m[32m        for raw in raw_values:[m
[32m+[m[32m            parent_id = _safe_int_id(raw)[m
[32m+[m[32m            if parent_id is not None:[m
[32m+[m[32m                cleaned.append(parent_id)[m
[32m+[m
[32m+[m[32m        if len(cleaned) > 0:[m
[32m+[m[32m            return list(dict.fromkeys(cleaned))[m
[32m+[m
[32m+[m[32m    # Common paired attributes.[m
[32m+[m[32m    paired_attrs = [[m
[32m+[m[32m        ("parent_a_id", "parent_b_id"),[m
[32m+[m[32m        ("parent1_id", "parent2_id"),[m
[32m+[m[32m        ("mother_id", "father_id"),[m
[32m+[m[32m        ("mom_id", "dad_id"),[m
[32m+[m[32m        ("parent_a", "parent_b"),[m
[32m+[m[32m        ("mother", "father"),[m
[32m+[m[32m    ][m
[32m+[m
[32m+[m[32m    cleaned = [][m
[32m+[m
[32m+[m[32m    for attr_a, attr_b in paired_attrs:[m
[32m+[m[32m        for attr in [attr_a, attr_b]:[m
[32m+[m[32m            if not hasattr(rock, attr):[m
[32m+[m[32m                continue[m
[32m+[m
[32m+[m[32m            parent_id = _safe_int_id(getattr(rock, attr))[m
[32m+[m
[32m+[m[32m            if parent_id is not None:[m
[32m+[m[32m                cleaned.append(parent_id)[m
[32m+[m
[32m+[m[32m        if len(cleaned) > 0:[m
[32m+[m[32m            return list(dict.fromkeys(cleaned))[m
[32m+[m
[32m+[m[32m    return [][m
