[32m+[m[32mdef get_ancestor_path_distances(game, rock_id, include_self=True, max_depth=12):[m
[32m+[m[32m    """[m
[32m+[m[32m    Return a dictionary:[m
[32m+[m
[32m+[m[32m        ancestor_id -> [distance_1, distance_2, ...][m
[32m+[m
[32m+[m[32m    Distance:[m
[32m+[m[32m        self = 0[m
[32m+[m[32m        parent = 1[m
[32m+[m[32m        grandparent = 2[m
[32m+[m[32m        great-grandparent = 3[m
[32m+[m
[32m+[m[32m    Multiple distances are kept because inbred pedigrees may have multiple[m
[32m+[m[32m    paths to the same ancestor.[m
[32m+[m[32m    """[m
[32m+[m[32m    rock_id = _safe_int_id(rock_id)[m
[32m+[m
[32m+[m[32m    if rock_id is None:[m
[32m+[m[32m        return {}[m
[32m+[m
[32m+[m[32m    distances = {}[m
[32m+[m
[32m+[m[32m    stack = [[m
[32m+[m[32m        (rock_id, 0, {rock_id})[m
[32m+[m[32m    ][m
[32m+[m
[32m+[m[32m    while len(stack) > 0:[m
[32m+[m[32m        current_id, depth, path_seen = stack.pop()[m
[32m+[m
[32m+[m[32m        if depth > max_depth:[m
[32m+[m[32m            continue[m
[32m+[m
[32m+[m[32m        if include_self or depth > 0:[m
[32m+[m[32m            distances.setdefault(current_id, []).append(depth)[m
[32m+[m
[32m+[m[32m        if depth == max_depth:[m
[32m+[m[32m            continue[m
[32m+[m
[32m+[m[32m        parent_ids = get_parent_ids_for_relationship(game, current_id)[m
[32m+[m
[32m+[m[32m        for parent_id in parent_ids:[m
[32m+[m[32m            parent_id = _safe_int_id(parent_id)[m
[32m+[m
[32m+[m[32m            if parent_id is None:[m
[32m+[m[32m                continue[m
[32m+[m
[32m+[m[32m            # Prevent accidental loops from bad saved data.[m
[32m+[m[32m            if parent_id in path_seen:[m
[32m+[m[32m                continue[m
[32m+[m
[32m+[m[32m            next_seen = set(path_seen)[m
[32m+[m[32m            next_seen.add(parent_id)[m
[32m+[m
[32m+[m[32m            stack.append([m
[32m+[m[32m                (parent_id, depth + 1, next_seen)[m
[32m+[m[32m            )[m
[32m+[m
[32m+[m[32m    return distances[m
[32m+[m
