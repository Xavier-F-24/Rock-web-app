[32m+[m[32mdef get_parent_ids_for_relationship(game, rock_id):[m
[32m+[m[32m    """[m
[32m+[m[32m    Robustly find parent ids for a rock.[m
[32m+[m
[32m+[m[32m    This supports several possible data models:[m
[32m+[m[32m    - rock.parents[m
[32m+[m[32m    - rock.parent_ids[m
[32m+[m[32m    - rock.parent_pair[m
[32m+[m[32m    - rock.parent_a_id / rock.parent_b_id[m
[32m+[m[32m    - rock.mother_id / rock.father_id[m
[32m+[m[32m    """[m
