[32m+[m[32mdef calculate_relatedness_r(game, rock_a_id, rock_b_id, max_depth=12):[m
[32m+[m[32m    """[m
[32m+[m[32m    Calculate coefficient of relationship R between two rocks.[m
[32m+[m
[32m+[m[32m    Formula:[m
[32m+[m[32m        R = sum over shared ancestors of (1/2)^(distance_a + distance_b)[m
[32m+[m
[32m+[m[32m    Examples:[m
[32m+[m[32m        parent-child: 1/2[m
[32m+[m[32m        full siblings: 1/2[m
[32m+[m[32m        half siblings: 1/4[m
[32m+[m[32m        uncle/niece: 1/4[m
[32m+[m[32m        first cousins: 1/8[m
[32m+[m
[32m+[m[32m    Returns:[m
[32m+[m[32m        r, contributions[m
[32m+[m
[32m+[m[32m    contributions:[m
[32m+[m[32m        dict ancestor_id -> contribution amount[m
[32m+[m[32m    """[m
[32m+[m[32m    rock_a_id = _safe_int_id(rock_a_id)[m
[32m+[m[32m    rock_b_id = _safe_int_id(rock_b_id)[m
[32m+[m
[32m+[m[32m    if rock_a_id is None or rock_b_id is None:[m
[32m+[m[32m        return 0.0, {}[m
[32m+[m
[32m+[m[32m    if rock_a_id == rock_b_id:[m
[32m+[m[32m        return 1.0, {rock_a_id: 1.0}[m
[32m+[m
[32m+[m[32m    ancestors_a = get_ancestor_path_distances([m
[32m+[m[32m        game,[m
[32m+[m[32m        rock_a_id,[m
[32m+[m[32m        include_self=True,[m
[32m+[m[32m        max_depth=max_depth[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    ancestors_b = get_ancestor_path_distances([m
[32m+[m[32m        game,[m
[32m+[m[32m        rock_b_id,[m
[32m+[m[32m        include_self=True,[m
[32m+[m[32m        max_depth=max_depth[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    shared_ancestors = set(ancestors_a.keys()) & set(ancestors_b.keys())[m
[32m+[m
[32m+[m[32m    r = 0.0[m
[32m+[m[32m    contributions = {}[m
[32m+[m
[32m+[m[32m    for ancestor_id in shared_ancestors:[m
[32m+[m[32m        subtotal = 0.0[m
[32m+[m
[32m+[m[32m        for distance_a in ancestors_a[ancestor_id]:[m
[32m+[m[32m            for distance_b in ancestors_b[ancestor_id]:[m
[32m+[m[32m                subtotal += 0.5 ** (distance_a + distance_b)[m
[32m+[m
[32m+[m[32m        if subtotal > 0:[m
[32m+[m[32m            contributions[ancestor_id] = subtotal[m
[32m+[m[32m            r += subtotal[m
[32m+[m
[32m+[m[32m    # Keep weird pedigrees from producing silly display values.[m
[32m+[m[32m    r = min(r, 1.0)[m
[32m+[m
[32m+[m[32m    return r, contributions[m
